# SALIN (jangan rename) berkas ini menjadi "rahasia.env" lalu isi nilainya.
# rahasia.env sudah masuk .gitignore dan tidak akan ter-commit.

SUPABASE_URL=https://xxxxxxxx.supabase.co
# Supabase > Project Settings > API Keys > Secret keys (sb_secret_...).
SUPABASE_SERVICE_KEY=ganti_dengan_secret_key

# Folder repositori situs, relatif terhadap folder cv-data.
# Nilai salah tidak memberi galat: bangun.py membuat folder baru dan
# menulis data.json ke sana, sehingga situs tidak ter-update.
SITUS_DIR=../../40_web/cv-site

NAMA_PRODI=Nama Prodi
NAMA_INSTITUSI=Universitas Contoh
